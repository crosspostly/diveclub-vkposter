# VK (VKontakte) community
# Get a community token: Community settings -> API usage -> Access tokens
# Required rights: wall, photos, groups, offline
VK_GROUP_TOKEN=

# Numeric id of the community (e.g. 123456789, without the minus)
VK_GROUP_ID=

# User access token with the 'photos' and 'video' scopes — required for ANY
# media upload (photos and videos). VK accepts only user tokens for
# photos.getWallUploadServer / video.save; community keys cannot upload media.
# Get it: vk.com/apps?act=manage -> your Standalone app -> Settings -> get token
# with the 'photos' (+ 'video' + offline) scopes; the user must be a community admin.
VK_USER_TOKEN=

VK_API_VERSION=5.199

# When true, post.py logs the call but does NOT actually call wall.post.
# Use this for the first dry runs.
DRY_RUN=false
