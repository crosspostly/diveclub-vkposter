# ── Dzen Auto-Publisher: переменные окружения ──────────────────────────────
# Скопируйте в .env:   Copy-Item .env.example .env   (Windows)
#                      cp .env.example .env          (Linux/macOS)
# .env НЕ коммитится (см. .gitignore) — это ваши личные данные!

# JSON с куками сессии Дзена (альтернатива файлу config/cookies.json).
# Как получить — README.md, раздел «Куки» (EditThisCookie → Export).
DZEN_COOKIES_JSON=

# Слаг канала из адреса студии: dzen.ru/profile/editor/<вот_этот_слаг>
DZEN_CHANNEL_SLUG=your-channel-slug

# Путь к feed.xml для статей (по умолчанию ./feed.xml в этой папке)
DZEN_FEED_PATH=

# HEADLESS=true — без окна браузера (по умолчанию); false — показывать браузер
HEADLESS=true
